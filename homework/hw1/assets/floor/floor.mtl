# Blender MTL File: 'None'
# Material Count: 1

newmtl None    # material name
Ns 500         # specular exponent (高光强度/锐利度)
Ka 0.8 0.8 0.8 # ambient color
Kd 0.8 0.8 0.8 # diffuse color
Ks 0.8 0.8 0.8 # specular color
d 1            # dissolve (不透明度， 1 → 不透明， 0 → 透明) (我们如果写透明度，用的是 transparency，和 d 相反)
illum 2        # illumination model (指定光照模型，数字代表什么意思见下面)

# 0   无光照（纯颜色）
# 1   只有漫反射
# 2   漫反射 + 镜面反射（最常见）
# 3   加反射
# 4+  更复杂（很少用）
