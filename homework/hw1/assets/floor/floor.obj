# Blender v2.91.0 OBJ File: ''
# www.blender.org

# 引用材质库文件 floor.mtl 
mtllib floor.mtl
# 对象名称: Plane（一个平面）
o Plane

# 顶点坐标 (v x y z)
# 四个顶点构成一个水平正方形地板，y=0 为地面，边长约 55.85
# v1: 左前角 (-x, +z)
# v2: 右前角 (+x, +z)
# v3: 左后角 (-x, -z)
# v4: 右后角 (+x, -z)
v -27.924055 0.000000 27.924055
v 27.924055 0.000000 27.924055
v -27.924055 0.000000 -27.924055
v 27.924055 0.000000 -27.924055

# 纹理坐标 (vt u v)，将整张纹理映射到地板四角
# uv1: 左下 → 对应 v1
# uv2: 右下 → 对应 v2
# uv3: 右上 → 对应 v4
# uv4: 左上 → 对应 v3
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000

# 法线 (vn x y z)，只有一条：朝上 (0,1,0)
vn 0.0000 1.0000 0.0000  # 地板法线，指向 +y（朝上）

# 使用名为 "None" 的材质（见 floor.mtl）
usemtl None
# 关闭光滑着色（flat shading）
s off

# 面 (f v/vt/vn ...)
# 一个四边形面，由 4 个顶点组成，逆时针排列
# 格式: 顶点索引/纹理坐标索引/法线索引
# v1→v2→v4→v3，构成地板四边形
f 1/1/1 2/2/1 4/3/1 3/4/1
